{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Information",
      "pdc.request": "Information"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 5,
        "excludedTypes": "Request;Exception"
      }
    }
  }
}
