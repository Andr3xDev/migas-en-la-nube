<mxfile host="app.diagrams.net">
  <diagram id="pipeline" name="Pipeline">
    <mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lane-ci" value="Workflow ci (pull request)" style="swimlane;whiteSpace=wrap;html=1;fontSize=13;startSize=28;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1560" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="pr" value="Pull request" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="lane-ci">
          <mxGeometry x="30" y="110" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="lint" value="lint&#xa;ruff, terraform fmt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-ci">
          <mxGeometry x="230" y="105" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="sec" value="security&#xa;Checkov, CodeQL" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-ci">
          <mxGeometry x="520" y="50" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="tfplan" value="terraform&#xa;dev and prod plan (read-only OIDC)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-ci">
          <mxGeometry x="520" y="170" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="test" value="test&#xa;pytest, minimum coverage 70 %" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-ci">
          <mxGeometry x="830" y="50" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="buildci" value="build&#xa;packages api/ and web/" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-ci">
          <mxGeometry x="1140" y="50" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="lane-cd" value="Workflow deploy (merge)" style="swimlane;whiteSpace=wrap;html=1;fontSize=13;startSize=28;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="1560" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="push" value="Push to dev or main&#xa;(PR merge)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="lane-cd">
          <mxGeometry x="20" y="60" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="testcd" value="Test (pytest, 70 % coverage)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-cd">
          <mxGeometry x="230" y="60" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b" value="build&#xa;api and web artifacts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-cd">
          <mxGeometry x="460" y="60" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="gate" value="Branch" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="lane-cd">
          <mxGeometry x="700" y="50" width="110" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="apply" value="deploy: OIDC login&#xa;terraform apply" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-cd">
          <mxGeometry x="880" y="60" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="seeds" value="seed products&#xa;and the admin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-cd">
          <mxGeometry x="1120" y="60" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="upload" value="upload web and api to SWA" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-cd">
          <mxGeometry x="1360" y="60" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="smoke" value="smoke: wait for /api/health&#xa;Bruno collection" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-cd">
          <mxGeometry x="1360" y="220" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="release" value="release: release-vN artifact (90 days)&#xa;tag vN" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane-cd">
          <mxGeometry x="990" y="220" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="endArrow=classic;html=1;" edge="1" parent="1" source="pr" target="lint"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;" edge="1" parent="1" source="lint" target="sec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;" edge="1" parent="1" source="lint" target="tfplan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;" edge="1" parent="1" source="sec" target="test"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;" edge="1" parent="1" source="test" target="buildci"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;" edge="1" parent="1" source="push" target="testcd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="endArrow=classic;html=1;" edge="1" parent="1" source="testcd" target="b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=classic;html=1;" edge="1" parent="1" source="b" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="dev: environment dev, no approval" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="gate" target="apply"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="855" y="395"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="main: environment prod, requires approval" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="gate" target="apply"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="855" y="515"/><mxPoint x="965" y="515"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" style="endArrow=classic;html=1;" edge="1" parent="1" source="apply" target="seeds"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="endArrow=classic;html=1;" edge="1" parent="1" source="seeds" target="upload"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="endArrow=classic;html=1;" edge="1" parent="1" source="upload" target="smoke"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="main only" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="smoke" target="release"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
