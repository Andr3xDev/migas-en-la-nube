<mxfile host="app.diagrams.net">
  <diagram id="rollback" name="Application rollback">
    <mxGraphModel dx="1200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="GitHub Actions&#xa;Run rollback.yml from main&#xa;with the tag, for example v12" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="approve" value="Approval of the prod environment" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="130" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="check" value="Does the tag match&#xa;^v[0-9]+$ ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="230" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="fail1" value="Fails" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="250" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="login" value="az login (OIDC)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="370" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="find" value="Is there a successful deploy on main&#xa;with that run number?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="470" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="fail2" value="Fails: unknown tag or&#xa;outside the last 200 runs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="495" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="download" value="Does the release-vN&#xa;artifact still exist?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="620" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="fail3" value="Fails" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="640" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="key" value="Reads the SWA token and host" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="760" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="upload" value="Uploads dist/web and dist/api&#xa;to the prod SWA" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="860" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="swa" value="Static Web Apps (prod)" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/preview/Static_Apps.svg;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="665" y="855" width="50" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="smoke" value="Waits for /api/health and runs&#xa;the read-only smoke" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="990" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="done" value="Prod serves the previous build&#xa;PDC_VERSION still shows the newest SHA" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="260" y="1090" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="endArrow=classic;html=1;" edge="1" parent="1" source="start" target="approve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;" edge="1" parent="1" source="approve" target="check"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="no" style="endArrow=classic;html=1;" edge="1" parent="1" source="check" target="fail1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="yes" style="endArrow=classic;html=1;" edge="1" parent="1" source="check" target="login"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;" edge="1" parent="1" source="login" target="find"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="no" style="endArrow=classic;html=1;" edge="1" parent="1" source="find" target="fail2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="yes" style="endArrow=classic;html=1;" edge="1" parent="1" source="find" target="download"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="no, expired after 90 days" style="endArrow=classic;html=1;" edge="1" parent="1" source="download" target="fail3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="yes" style="endArrow=classic;html=1;" edge="1" parent="1" source="download" target="key"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="endArrow=classic;html=1;" edge="1" parent="1" source="key" target="upload"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="endArrow=classic;html=1;" edge="1" parent="1" source="upload" target="swa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="endArrow=classic;html=1;" edge="1" parent="1" source="upload" target="smoke"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="endArrow=classic;html=1;" edge="1" parent="1" source="smoke" target="done"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
