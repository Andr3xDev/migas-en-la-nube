<mxfile host="app.diagrams.net">
  <diagram id="rollback" name="Application rollback">
    <mxGraphModel dx="1191" dy="815" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" value="GitHub Actions&#xa;Run rollback.yml from main&#xa;with the tag, for example v12" vertex="1">
          <mxGeometry height="70" width="240" x="280" y="20" as="geometry" />
        </mxCell>
        <mxCell id="approve" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Approval of the prod environment" vertex="1">
          <mxGeometry height="60" width="240" x="280" y="130" as="geometry" />
        </mxCell>
        <mxCell id="check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;" value="Does the tag match&#xa;^v[0-9]+$ ?" vertex="1">
          <mxGeometry height="100" width="240" x="280" y="230" as="geometry" />
        </mxCell>
        <mxCell id="fail1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" value="Fails" vertex="1">
          <mxGeometry height="60" width="200" x="640" y="250" as="geometry" />
        </mxCell>
        <mxCell id="login" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="az login (OIDC)" vertex="1">
          <mxGeometry height="60" width="240" x="280" y="370" as="geometry" />
        </mxCell>
        <mxCell id="find" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;" value="Is there a successful deploy on main&#xa;with that run number?" vertex="1">
          <mxGeometry height="110" width="280" x="260" y="470" as="geometry" />
        </mxCell>
        <mxCell id="fail2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" value="Fails: unknown tag or&#xa;outside the last 200 runs" vertex="1">
          <mxGeometry height="60" width="200" x="640" y="495" as="geometry" />
        </mxCell>
        <mxCell id="download" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;" value="Does the release-vN&#xa;artifact still exist?" vertex="1">
          <mxGeometry height="100" width="240" x="280" y="620" as="geometry" />
        </mxCell>
        <mxCell id="fail3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" value="Fails" vertex="1">
          <mxGeometry height="60" width="200" x="680" y="640" as="geometry" />
        </mxCell>
        <mxCell id="key" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Reads the SWA token and host" vertex="1">
          <mxGeometry height="60" width="240" x="280" y="760" as="geometry" />
        </mxCell>
        <mxCell id="upload" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Uploads dist/web and dist/api&#xa;to the prod SWA" vertex="1">
          <mxGeometry height="60" width="240" x="280" y="860" as="geometry" />
        </mxCell>
        <mxCell id="swa" parent="1" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/preview/Static_Apps.svg;verticalLabelPosition=bottom;verticalAlign=top;" value="Static Web Apps (prod)" vertex="1">
          <mxGeometry height="50" width="50" x="665" y="855" as="geometry" />
        </mxCell>
        <mxCell id="smoke" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Waits for /api/health and runs&#xa;the read-only smoke" vertex="1">
          <mxGeometry height="60" width="240" x="280" y="990" as="geometry" />
        </mxCell>
        <mxCell id="done" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="Prod serves the previous build&#xa;PDC_VERSION still shows the newest SHA" vertex="1">
          <mxGeometry height="70" width="280" x="260" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="start" style="endArrow=classic;html=1;" target="approve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="approve" style="endArrow=classic;html=1;" target="check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="check" style="endArrow=classic;html=1;" target="fail1" value="no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="check" style="endArrow=classic;html=1;" target="login" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="login" style="endArrow=classic;html=1;" target="find">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="find" style="endArrow=classic;html=1;" target="fail2" value="no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="find" style="endArrow=classic;html=1;" target="download" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="download" style="endArrow=classic;html=1;" target="fail3" value="no, expired after 90 days">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="download" style="endArrow=classic;html=1;" target="key" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="key" style="endArrow=classic;html=1;" target="upload">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="upload" style="endArrow=classic;html=1;" target="swa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="upload" style="endArrow=classic;html=1;" target="smoke">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="smoke" style="endArrow=classic;html=1;" target="done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
